    {
      "parameters": {
        "promptType": "define",
        "text": "=Lead details:\nName: {{ $('Get a quote').item.json.Name }}\nCompany: {{ $('Get a quote').item.json.Company }}\nNeed: {{ $('Get a quote').item.json['What do you need?'] }}\nBudget: {{ $('Get a quote').item.json.Budget }}\nTimeline: {{ $('Get a quote').item.json.Timeline }}\nScore: {{ $('Score lead').item.json.output.score }}\nSummary: {{ $('Score lead').item.json.output.summary }}",
        "messages": {
          "messageValues": [
            {
              "message": "=You write follow-up emails for PixelCraft Studio, a small agency that builds websites and automations for small businesses.\n\nWrite a short, warm, personal email (under 120 words) replying to the lead's request. Mention their specific need so it doesn't feel generic.\n\nBy score:\n- Hot: suggest a quick call this week to discuss details.\n- Warm: ask one helpful question about their project and offer to send examples.\n- Cold: send a brief, polite reply with no pressure.\n\nRules:\n- Never mention prices, discounts, or deadlines.\n- Never promise anything specific.\n- Start with \"Hi [first name],\" and end with \"Best regards, PixelCraft Studio team\".\n- Output only the email text, with no subject line and no extra comments.\n- Only mention things the lead actually said. Don't assume what they want.\n- Don't claim past projects or experience."
            }
          ]
        },
        "batching": {}
      },
